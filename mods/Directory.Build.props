<Project>
  <!-- Shared settings for mods on Windows and native Linux. -->
  <PropertyGroup>
    <!--
      Which game a project builds against: a project named *.Mycopunk or *.Emberville is for that game, any other for Valheim. Claude Tools'
      core (mods/ClaudeTools) uses no game's code and builds against any of them (-p:Game=Mycopunk; each game's adapter asks for its own).
    -->
    <Game Condition="'$(Game)' == '' and $(MSBuildProjectName.EndsWith('.Mycopunk'))">Mycopunk</Game>
    <Game Condition="'$(Game)' == '' and $(MSBuildProjectName.EndsWith('.Emberville'))">Emberville</Game>
    <Game Condition="'$(Game)' == ''">Valheim</Game>

    <ValheimDir Condition="'$(ValheimDir)' == ''">$(VALHEIM_DIR)</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' and '$(OS)' == 'Windows_NT'">D:/SteamLibrary/steamapps/common/Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' and Exists('$(HOME)/.local/share/Steam/steamapps/common/Valheim/valheim.x86_64')">$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' and Exists('$(HOME)/.steam/steam/steamapps/common/Valheim/valheim.x86_64')">$(HOME)/.steam/steam/steamapps/common/Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' and Exists('$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Valheim/valheim.x86_64')">$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
    <MycopunkDir Condition="'$(MycopunkDir)' == ''">$(MYCOPUNK_DIR)</MycopunkDir>
    <MycopunkDir Condition="'$(MycopunkDir)' == ''">$(MYCO_GAMEDIR)</MycopunkDir>
    <MycopunkDir Condition="'$(MycopunkDir)' == '' and '$(OS)' == 'Windows_NT'">D:/SteamLibrary/steamapps/common/Mycopunk</MycopunkDir>
    <EmbervilleDir Condition="'$(EmbervilleDir)' == ''">$(EMBERVILLE_DIR)</EmbervilleDir>
    <EmbervilleDir Condition="'$(EmbervilleDir)' == '' and '$(OS)' == 'Windows_NT'">D:/SteamLibrary/steamapps/common/Emberville Demo</EmbervilleDir>

    <!-- the game's folder and its data folder (where Unity keeps Managed) -->
    <GameDir Condition="'$(Game)' == 'Valheim'">$(ValheimDir)</GameDir>
    <DataDir Condition="'$(Game)' == 'Valheim'">valheim_Data</DataDir>
    <GameDir Condition="'$(Game)' == 'Mycopunk'">$(MycopunkDir)</GameDir>
    <DataDir Condition="'$(Game)' == 'Mycopunk'">Mycopunk_Data</DataDir>
    <GameDir Condition="'$(Game)' == 'Emberville'">$(EmbervilleDir)</GameDir>
    <DataDir Condition="'$(Game)' == 'Emberville'">Emberville_Data</DataDir>

    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>full</DebugType> <!-- ScriptEngine needs the .pdb next to the DLL -->
    <DebugSymbols>true</DebugSymbols>
    <ManagedDir>$(GameDir)/$(DataDir)/Managed</ManagedDir>
    <BepInExDir>$(GameDir)/BepInEx</BepInExDir>
    <!-- All mods, including the manager, deploy to scripts for hot reload. -->
    <DeployDir>$(BepInExDir)/scripts</DeployDir>
    <!-- (the newer games' DLLs and .NET Framework disagree on some versions: harmless) -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- Claude Tools' core built for another game gets its own folders, so each game's build stays (bin/Release/Mycopunk/net48) -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ClaudeTools' and '$(Game)' != 'Valheim'">
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <OutputPath>bin/$(Configuration)/$(Game)/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/$(Game)/</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the .NET SDK compile for .NET Framework without Visual Studio's targeting packs -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <Reference Include="BepInEx"><HintPath>$(BepInExDir)/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(ManagedDir)/UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(ManagedDir)/UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExDir)/core/Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>

    <!-- Says in every mod's DLL that it was made with AI, as Thunderstore asks (as an attribute in code: GenerateAssemblyInfo is off). -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/AiDisclosure.cs" Link="Shared/AiDisclosure.cs" />
    <!-- Moving settings over from a mod's old GUID (com.dhack.* became com.quad.*), and standing down next to an old copy. -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Migration.cs" Link="Shared/Migration.cs" />
  </ItemGroup>

  <!--
    The game's own code, for the mods that use it. Claude Tools' core sets UsesGameCode to false: it never references a game, so one core
    serves every game (the game's adapter, ClaudeTools.Valheim and the like, does what needs the game).
  -->
  <ItemGroup Condition="'$(UsesGameCode)' != 'false' and '$(Game)' == 'Valheim'">
    <Reference Include="assembly_valheim"><HintPath>$(ManagedDir)/assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(ManagedDir)/assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ManagedDir)/assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Splatform"><HintPath>$(ManagedDir)/Splatform.dll</HintPath><Private>false</Private></Reference>
    <!-- the on-screen notice when an old copy of a mod is installed too (without it, Shared/Migration.cs says so in the log only) -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/MigrationNotice.cs" Link="Shared/MigrationNotice.cs" />
  </ItemGroup>
  <!-- Mycopunk and Emberville: Assembly-CSharp, publicized (private members usable, as the mycopunk-mods repo builds its mods) -->
  <ItemGroup Condition="'$(UsesGameCode)' != 'false' and ('$(Game)' == 'Mycopunk' or '$(Game)' == 'Emberville')">
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" ExcludeAssets="compile; runtime" />
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private><Publicize>true</Publicize></Reference>
    <Reference Include="netstandard"><HintPath>$(ManagedDir)/netstandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- A mod with translations/English.json speaks the player's language: Shared/Translations.cs, and every translations/*.json built
       into the DLL (as "translations/<Language>.json"). -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/translations/English.json')">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Translations.cs" Link="Shared/Translations.cs" />
    <EmbeddedResource Include="$(MSBuildProjectDirectory)/translations/*.json" LogicalName="translations/%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(Game)' == 'Valheim' and !Exists('$(ManagedDir)/assembly_valheim.dll')" Text="Valheim assemblies not found. Set VALHEIM_DIR or pass -p:ValheimDir=/path/to/Valheim." />
    <Error Condition="'$(Game)' == 'Mycopunk' and !Exists('$(ManagedDir)/Assembly-CSharp.dll')" Text="Mycopunk assemblies not found. Set MYCOPUNK_DIR or pass -p:MycopunkDir=/path/to/Mycopunk." />
    <Error Condition="'$(Game)' == 'Emberville' and !Exists('$(ManagedDir)/Assembly-CSharp.dll')" Text="Emberville assemblies not found. Set EMBERVILLE_DIR or pass -p:EmbervilleDir=/path/to/Emberville." />
    <Error Condition="!Exists('$(BepInExDir)/core/BepInEx.dll')" Text="BepInEx not found in $(GameDir). Install the mod loader first." />
  </Target>

  <!-- Set DeployToGame=false for validation or publishing without changing the running game. -->
  <Target Name="DeployToGameFolder" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DeployDir)" />
    <Message Importance="high" Text="Deployed $(MSBuildProjectName) -> $(DeployDir)" />
  </Target>
</Project>
