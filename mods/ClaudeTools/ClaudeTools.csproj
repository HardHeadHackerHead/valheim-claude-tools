<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Claude Tools' core: the request mailbox, its commands for any Unity game, the dev loader and the mod-maker commands. It uses no game's
    code (UsesGameCode false), so the same source serves every game; each game's adapter (ClaudeTools.Valheim, ClaudeTools.Mycopunk) builds
    it against that game's Unity (-p:Game=Mycopunk, see mods/Directory.Build.props) and carries the game's guide, skills and tools.
  -->
  <PropertyGroup>
    <AssemblyName>ClaudeTools</AssemblyName>
    <RootNamespace>ClaudeTools</RootNamespace>
    <UsesGameCode>false</UsesGameCode>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="netstandard"><HintPath>$(ManagedDir)/netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(ManagedDir)/UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ManagedDir)/UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <!-- (the dev loader loads a game's adapter bound to this copy, under its hot-loaded name: CoreLink finds it) -->
    <Compile Include="../Shared/CoreLink.cs" Link="Shared/CoreLink.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The guide for AI assistants in a game whose adapter brings none; the mod writes it to BepInEx/claude/CLAUDE.md. -->
    <EmbeddedResource Include="GUIDE.md" LogicalName="guide/CLAUDE.md" />
  </ItemGroup>
</Project>
